# Copy this file to .env.local and fill it in. .env.local is never committed.

# Supabase (Project Settings > API): project URL and "anon public" key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public address of the site, without trailing slash. Enables LinkedIn previews, the canonical URL,
# sitemap.xml and robots.txt. Leave empty in local development, set it on Vercel.
# Example: VITE_SITE_URL=https://sidali-abubakar.vercel.app
VITE_SITE_URL=

# Optional: Umami visit statistics (https://cloud.umami.is). Both must be set to enable them.
VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
VITE_UMAMI_WEBSITE_ID=
